# Development can run without these variables, with local storage in .data/state.json.
# Production fails closed until all three required values below are configured.

# Required in production. Install Neon through Vercel Marketplace; it injects this.
DATABASE_URL=

# Required in production, or whenever a real database is connected.
# Use a unique password of at least 16 characters. Never commit your .env.local.
APP_PASSWORD=

# Required alongside APP_PASSWORD. Generate at least 32 random characters.
# Run: node scripts/generate-secrets.mjs
SESSION_SECRET=

# Optional canonical origin if a reverse proxy changes the incoming request origin.
# Example: https://your-project.vercel.app (no trailing slash)
APP_ORIGIN=
